{
  "name": "ctftime-bot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "dev:cron": "curl -s 'http://localhost:13575/cdn-cgi/local/scheduled?format=json'",
    "build": "vite build",
    "deploy": "CLOUDFLARE_ENV=production bun run build && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging bun run build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json",
    "lint": "bunx --bun biome check",
    "format": "bunx --bun biome check --write",
    "test": "bun test",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply ctftime-bot --local",
    "db:migrate": "wrangler d1 migrations apply ctftime-bot --remote",
    "discord:register": "bun run scripts/register-commands.ts"
  },
  "dependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.38",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commitlint": "^21.2.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "dayjs": "^1.11.13",
    "hono": "^4",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "^4",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/bun": "^1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7",
    "vite": "^8.3.0",
    "wrangler": "^4"
  }
}
